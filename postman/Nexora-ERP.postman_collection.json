            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Vikas Trading Co\",\n  \"mobile\": \"+919988112233\",\n  \"email\": \"vikas@trading.in\",\n  \"businessName\": \"Vikas Trading Company\",\n  \"gstNumber\": \"07AAAAA9999A1Z2\",\n  \"customerType\": \"WHOLESALE\",\n  \"address\": \"102 Main Wholesale Market, Delhi 110006\",\n  \"status\": \"ACTIVE\",\n  \"notes\": \"New wholesale account\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]

# ==========================================
# NEXORA ERP - Environment Variables Example
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=postgresql://nexora_user:nexora_password@localhost:5432/nexora_db?schema=public
JWT_EXPIRES_IN=1d

# SQLite Database URL
# Local development:
DATABASE_URL="file:./prisma/dev.db"

# Production on Render (persistent disk mounted at /data):
# DATABASE_URL="file:/data/nexora.db"

# Frontend URL (CORS allowed origin)
FRONTEND_URL=http://localhost:5173

# Frontend Environment Variable (Vite) - set this in Vercel dashboard
# VITE_API_BASE_URL=https://nexora-backend.onrender.com/api
